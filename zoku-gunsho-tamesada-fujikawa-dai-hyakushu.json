    }
   ]
  },
  {
   "id": "zoku-gunsho-tamesada-fujikawa-dai-hyakushu-0011",
   "pid": "nao-733748",
   "pages": [
    11
   ],
   "text": "さりともとものみをかれて春日山うき身わするゝ北の夏なみ遠日懐旧也しのはるゝそのいにしへはへたゝりてまたぬ月日のなとつもるらん社頭祝言よろつ代に松のちとせの泉そへて君をそまもるむよしの神",
   "poems": [
    "92",
    "93",
    "94"
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "やすらはてこへける春のたよりとや霞の関の名にをあつてん",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関路早春",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "し賀の浦や浪まもかさむ朝なきにのとかにわたるあまのつり舟",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一洞上朝霞",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "花さかぬ四方の梢の春霞まつと八かりのこゝろへたつな",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霞隔遠樹",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "古巣いてなれも旅なる程なれやしらぬ野山のうくひすの声",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "薪中閔尊",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "夢は猶かくれぬ物とあしかきのへたつる竹に暮そなく",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "隣家竹尊",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "一煉ならてとはるへしとはしらさりしかなし田面に表裏さそつむ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田辺若菜",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "もはいつる草の葉こゑもあらはれてあさらは小野にのこる雪",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野外浅雪",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "梅かゝも袂にとまる匂ひとてしはしやすらふ春のやまこえ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山路梅花",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "さそひゆく風のたよりの根岡かを尋ても猶やまとはん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "梅薫夜風",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "影うつす池にて草の茂るまて春をそへぬるは柳のいと",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水辺古柳",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "またれつる心つくしにふる雨の如くみをいそくやまされらかな",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雨中待図",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "花の色にとめし心の名残とてすみやはてなん野へのかり庵",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野岡留人",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "きかへつる雲ともみへ召山桜はては霞のたちへたてつゝ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遠望山花",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "有明の月はつれなき庭の面に本や則のときをしるらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁庭落花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "みし人もなき壁の梢とてくるゝもやすき花のいろな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "故郷夕花",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "春ことにかすむならひの名取つなき名ともみぬ月の影を",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河上春月",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "したふきよまたふかき夜の月影に雨影そめてかへるかりかね",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "深夜飯雁",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "かせ吹は松の下水行かゝに木すゑもなひく麦の藤なみ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "藤花随風",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "いたつらにとはれし春をやまふきの花にそかこす各の色物",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "橋辺穀冬",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "したへとも春はとまらぬかなし江にもならし小船潰や帰らん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "舟中暮春",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "一卯花の国にも猶やたとるらん雲にまよひしをのゝほそ道",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "卯花隠路",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "数ならぬ身にはならはぬはつ音とてきくてもたとる時鳥かな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初聞郭公",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "ほとゝますきかすといはゝ山ふかみすむかひなしと人也おもはむ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家時鳥",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "池水の浪ませかけてあやめ草けさひく袖は露そみたるゝ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "池朝菖蒲",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "蚊遣火の煙たてすはいかにしてこの山陰のやとをしらまし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "閑居蚊火",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "夢なしてむかしにかよふ名残とやね兄の袖にかほるたちはな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "兼橋驚夢",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "かきくらす日数もしらすかしは木のたて久しき五月雨の頃",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杜五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "露結ふ夕になれは荷の野の草のしけみも分きかねぬる",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野夕夏草",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "谷ふかみ浅からぬ身の声の声の声にしられてとふほたるかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖底蛍堂",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "こそやうて日数かきぬる山ちをもやすくそ過るゆふたちの雲",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "行路夕立",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "いつのまに吹かはりけんこのねぬるあさけの袖の礫のはつ風",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初秋朝風",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "天河あはぬ市月をかさねてそななし恨の数もそひける",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "閏月七夕",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "一船萩の花もあたなる夕露にむすもりの野へのいほかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野亭夕萩",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "明わたる入江の浪はしつりにて荻の末葉にのこるうら風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "江辺曙蔽",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "うきことを思かつらねぬ雁かねもなきてそきぬるあきの山さと",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家初雁",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "わたの糸いつくを波のかきりとて夜ゆく月のかけをまつらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海上待月",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "も日月の心つくしのつきなきも松にそことにおもひしりぬる",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松州夜月",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "恙なりて又あくかるゝ心かなよしのゝおくの秋のよのつき",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "深山見月",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "むらひをく露の契りもあらはれて軒のしのふにやとる月かな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "草露映月",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "夜もすからやとるはかりの月影をとめすはつらし須磨の関守",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関路惜月",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "数ならぬうき身の友とてのむ求はおもひやまさきをしかのこゑ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鹿多夜友",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "まとろまてゆるとはかりのしるしかな秋の田面に表うつこゑ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田家楼衣",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "わたし守舟さしかけていそくまてくれぬとみゆる陰のあきり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古渡眺霧",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "かはりゆく図をはしらす武蔵野也なへて草集に胡風きふく",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋風幡野",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "咲みたす花のまきに鳴せや呼は千種に物材ふらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "籬下聞画",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "谷川の浅瀬の水やまさるしんふかきもみちの色をうつして",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅葉写水",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "山ふかきあきの紅葉の色よりも浅からすこそたつねいりぬれ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山中紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "はかなしやあたなる露の色にた猶うつまるゝあさかほのはな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "露道謹花",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "色かはな霜也はをそきあほにほのかにうつるしらきくの花",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河辺菊花",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "とまらすはいかにせんとて断おきのわか身ひとつにかなし給らん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "独惜善秋",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "神無月あはれはかはるしなしにてあきより水にふるしくれ哉",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首初冬時雨",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "さそひこし嵐もをのかまゝならて霞に朽ぬる庭のもちき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霜埋落葉",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "いとはれししくれの後の真木の屋と音もかはらてふるあられ哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "屋上聞敷",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "さそはく雲のまよひにかつふりて雲も初瀬のやまかせそいく",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古寺初雪",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "とはれける身のならはしのありかほと跡いとはるゝ道の白雲",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭雪献人",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "ふる雪はつもりにけりなしら波の音せてこゆるすゑの松山",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海辺松霊",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "難波波入口の浪はさるたて藁の枯葉は風もたまらす",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水郷寒兼",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "音経て石賀の浦なみこほる夜はたちもさはかて鳴なとりかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖上千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "池水に奥もはなれぬ芦鴨のうきねはかりそこほらさりける",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒夜水鳥",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "いたつらに氷かさねてゆく事の日数もしらぬ谷川のみつ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮間水",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "さそのくる霞のひまの春風にまたみぬ花の行末をきとふ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初尋縁兼",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "つれなさはかはらぬ中のつらさにてみしを忘るゝ心ともかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "閔夢忍応",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "ちきりしをたのむはかりになからへて消ぬへき身の年はへにけり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "契経年恋",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "かはり行人の心のいつはりはうともはてぬつらさなりけり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "諚真階応",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "恨つるわりこと蛍も忘られてまさるつらさにかける玉つさ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "返事増応",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "うきなから数ならぬ身のつらさをもいとはれてこほれしりぬれ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "被成賤恋",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "あたなりや道の芝草かりそめにむすひすてぬる歌のちきりは",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "途中契恋",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "ふかき夜の別といひて真木の戸のあせぬにかへる身とはしられし",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "従門帰応",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "しるとて人込かこれはなをさりにをしへし宿といれも恨みん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忘住所恋",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "神にたにうき身の程をしられすはあふにかへんとおやいのらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "依応祈身",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "いとふそよかよふ心のたのみたになくてへたつる嶺のしら雲",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "隔遠路応",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "いかにそんかき名をかへてかこつともつらき心の人をわかすは",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "借人名恋",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "一おなし世につまをさへにたせるこそ餘りこそなる契りなりけれ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "絶不知恋",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "つらかりし心くらへをたからきにおもひさためてとをさるらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "五帖勲",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "暁の鳥のなく音をしるへにてねさめの程其身にならひぬる",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑二十首暁更寝覚",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "吹風もおなしみとりの松かえに夕は何とさひしかならん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "薄暮松風",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "わか君の如くみをそへてふるゝゆにみかさの竹の白きとなる",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "両中縁竹",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "むす苔の色もははらてうちよする岩間の波の音そくたくる",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浪洗石苦",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "待出る程そ久しきかつらきや高間の山のあきのよの月",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "高山待月",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "滝の音もまた閔なれぬ山水にならはてすむは心なりけり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山中瀧水",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "千代をへて一度すめる川水のなかれは君さくむへかりける",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河水流清",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "立帰りおなし野原にあくかれて菊ももみちも身にそなれぬる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春夜野遊",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "旅人のたへぬゆきゝに相坂の関守いかにくるしかるらむ哉",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関路行容",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "山里にたへてすまんとあもひしは嵐もきかぬゆふへなりけり",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家夕嵐",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "おもひやれたゝ人めの冬にたにかきらぬ山のなくのさひしさ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家人稀",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "見いたせは浪間の日願くれぬらしはや漕帰れあきのつり舟",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海路眺望",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "ちきらすよなれし都の夜半の月草の柱のなとなれとは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月羇中友",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "都なふかり程の袖にふるまやほさぬ涙のたくひなるらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅宿夜雨",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "へたてつる夜の間の雲やわかるらんあらはれそむる沖津しら浪",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海辺暁雲",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "あたに見し一夜の夢のそのまゝにさめてはもとの浮世なりけり",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄貫無常",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "うつもるゝ霜の下草あらはれてさかへん春のひたをそまつ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄草述懐",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "さりともとものみをかれて春日山うき身わするゝ北の夏なみ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄木述懐",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "しのはるゝそのいにしへはへたゝりてまたぬ月日のなとつもるらん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "逐日懐旧",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "よろつ代に松のちとせの泉そへて君をそまもるむよしの神",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733748",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "社頭祝言",
   "kotobagaki": ""
  }
 ],
